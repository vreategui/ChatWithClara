# Copy this file to .env and fill in real values.

# Free Groq API key -> https://console.groq.com/keys (no credit card needed for free tier)
GROQ_API_KEY=your_groq_api_key_here

# Any random long string, used to sign login tokens. Change this to your own random text.
JWT_SECRET=change_this_to_a_long_random_string

# Port the backend server listens on
PORT=3000
